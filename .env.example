# Model gateway (OpenAI-compatible). Default: NVIDIA API catalog; switch to Meterless when set up.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-xxxxxxxx
LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
# Web search for agents, free tier 1000 searches/month: https://app.tavily.com
TAVILY_API_KEY=tvly-xxxxxxxx

# Model gateway (OpenAI-compatible). This is the single injected generator for all agents;
# point it at a Meterless gateway, NVIDIA (https://integrate.api.nvidia.com/v1) or OpenRouter.
# Leave LLM_API_KEY empty to run in sample mode (replays samples/*.jsonl).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Web search for agents, free tier: https://app.tavily.com
TAVILY_API_KEY=
# Zetaris local platform (optional; the agent skips it if unreachable)
ZETARIS_URL=http://localhost:8888/api/v1.0
ZETARIS_UI_URL=http://localhost:3000
ZETARIS_USERNAME=admin@zetaris.com
ZETARIS_PASSWORD=
# SEC EDGAR and company_dns require an identifying User-Agent: "app_name you@example.com"
ZETARIS_USER_AGENT=
# SAMPLE_MODE=1
